#!/usr/bin/env bash
# Sandboxed Claude Code agent on a local Ollama model.
#
#   ./agent setup                 build the Ollama model variant (run once / after config change)
#   ./agent new   NAME            create projects/NAME (git repo + CLAUDE.md + TODO.md)
#   ./agent chat  NAME            interactive Claude Code session in the sandbox
#   ./agent loop  NAME [ITERS] [-j N]  work through TODO.md with N agents (default AGENTS)
#   ./agent worker NAME [ID] [ITERS]   add one agent to NAME's running loop
#   ./agent status [NAME]         agents, their tasks, and what each open task waits on
#   ./agent stop  NAME [--now|--kill]  stop after the current task; --now: interrupt, write a 2-line
#                                 handoff and continue that task next time; --kill: no handoff yet
#   ./agent run   NAME "PROMPT"   one headless run with a custom prompt
#   ./agent shell NAME            bash inside the sandbox (to poke around)
#   ./agent list                  list projects
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=config.env
source "$ROOT/config.env"
# Optional secrets passed into the sandbox (GH_TOKEN=...). Not committed.
[[ -f "$ROOT/secrets.env" ]] && source "$ROOT/secrets.env"
: "${MAX_STEP_ATTEMPTS:=0}" "${ITER_TIMEOUT:=0}"   # defaults for older config.env files
: "${AGENTS:=1}" "${NUM_PARALLEL:=1}" "${CTX_MARGIN:=8192}"

SANDBOX_HOME="$ROOT/home"            # becomes /home/agent inside the sandbox
PROJECTS="$ROOT/projects"
LOGS="$ROOT/logs"
RUN="$ROOT/run"
CLAUDE_BIN="$(readlink -f "${AGENT_CLAUDE_BIN:-$(command -v claude)}")"   # AGENT_CLAUDE_BIN: tests use a fake
# BACKEND=ollama: Ollama serves MODEL. BACKEND=llama: ./llamasrv runs the same GGUF on llama-server,
# which gives NUM_PARALLEL real slots (Ollama runs qwen35 models one request at a time).
: "${BACKEND:=ollama}" "${LLAMA_URL:=http://127.0.0.1:11500}"
API_URL="$OLLAMA_URL"; [[ "$BACKEND" == llama ]] && API_URL="$LLAMA_URL"
API_PORT="${API_URL##*:}"

die() { echo "error: $*" >&2; exit 1; }

project_dir() {
  [[ -n "${1:-}" ]] || die "project name required"
  local dir="$PROJECTS/$1"
  [[ -d "$dir" ]] || die "no project '$1' (create it with: ./agent new $1)"
  echo "$dir"
}

check_ollama() {
  if [[ "$BACKEND" == llama ]]; then
    curl -sf "$LLAMA_URL/health" >/dev/null || "$ROOT/llamasrv" start >&2 || die "llama-server did not start (./llamasrv logs)"
    return 0
  fi
  ! systemctl --user is-active -q llama-agent 2>/dev/null || die "BACKEND=ollama but llama-server holds the GPUs (./llamasrv stop)"
  curl -sf "$OLLAMA_URL/api/version" >/dev/null || die "Ollama not reachable at $OLLAMA_URL"
  ollama list | awk '{print $1}' | grep -qx "$MODEL:latest" || die "model '$MODEL' missing — run: ./agent setup"
}

# sandbox PROJECT_DIR [--tty] -- CMD...
# Filesystem: read-only system dirs, private $HOME (loop/home), only the project is writable.
sandbox() {
  local proj="$1"; shift
  local tty=0
  [[ "${1:-}" == "--tty" ]] && { tty=1; shift; }
  [[ "${1:-}" == "--" ]] && shift

  # Host-side proxy that pings slow streams, so Claude Code's 300 s idle watchdog doesn't abort
  # long tool calls that Ollama is still generating (see keepalive.py).
  mkdir -p "$RUN" "$LOGS"
  local kafile ka_pid ka_port status=0
  kafile="$(mktemp "$RUN/keepalive.XXXXXX")"
  python3 "$ROOT/keepalive.py" 0 "127.0.0.1:$API_PORT" --tag "${SB_TAG:-$(basename "$proj")}" \
    $([[ "$BACKEND" == llama ]] && echo "--ollama-shim $MODEL") \
    > "$kafile" 2>>"$LOGS/keepalive.log" &
  ka_pid=$!
  for _ in {1..50}; do [[ -s "$kafile" ]] && break; sleep 0.1; done
  ka_port="$(head -1 "$kafile")"; rm -f "$kafile"
  [[ -n "$ka_port" ]] || { kill "$ka_pid" 2>/dev/null; die "keepalive proxy failed to start"; }
  local api_port="$ka_port"; [[ "$NET" == "on" ]] || api_port="$API_PORT"   # NET=off: bridge listens there

  local args=(
    --ro-bind /usr /usr
    --symlink usr/bin /bin --symlink usr/sbin /sbin
    --symlink usr/lib /lib --symlink usr/lib64 /lib64
    --ro-bind /etc /etc
    --ro-bind-try /run/systemd/resolve /run/systemd/resolve
    --proc /proc --dev /dev
    --tmpfs /tmp
    --bind "$SANDBOX_HOME" /home/agent
    --ro-bind "$CLAUDE_BIN" /opt/claude/claude
    --ro-bind "$ROOT/prompts" /opt/agent/prompts
    --ro-bind "$ROOT/hooks" /opt/agent/hooks
    --ro-bind "$ROOT/bridge.py" /opt/agent/bridge.py
    --ro-bind "$ROOT/mcp" /opt/agent/mcp
    --bind "$proj" /work
    --chdir /work
    --unshare-all --hostname sandbox
    --die-with-parent
    --clearenv
    --setenv HOME /home/agent
    --setenv USER agent
    --setenv PATH /home/agent/.local/bin:/opt/claude:/usr/local/bin:/usr/bin
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv ANTHROPIC_BASE_URL "http://127.0.0.1:$api_port"
    --setenv ANTHROPIC_AUTH_TOKEN ollama
    --setenv ANTHROPIC_API_KEY ""
    --setenv ANTHROPIC_MODEL "$MODEL"
    --setenv ANTHROPIC_DEFAULT_OPUS_MODEL "$MODEL"
    --setenv ANTHROPIC_DEFAULT_SONNET_MODEL "$MODEL"
    --setenv ANTHROPIC_DEFAULT_HAIKU_MODEL "$MODEL"
    --setenv CLAUDE_CODE_SUBAGENT_MODEL "$MODEL"
    # Ollama's real prompt is ~5k tokens more than the usage Claude Code sees, hence the margin.
    --setenv CLAUDE_CODE_MAX_CONTEXT_TOKENS "$((NUM_CTX - CTX_MARGIN))"
    --setenv CLAUDE_CODE_AUTO_COMPACT_WINDOW "$((NUM_CTX - CTX_MARGIN))"
    --setenv CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC 1
    --setenv CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK 1   # pings only help streams
    # A request queued behind other agents' requests gets no bytes until a slot frees up; allow for it
    # (keepalive.py stops pinging at the same 30 min, so a stuck request still fails).
    --setenv API_TIMEOUT_MS 1800000
    --setenv DISABLE_AUTOUPDATER 1
    --setenv GIT_AUTHOR_NAME agent --setenv GIT_AUTHOR_EMAIL agent@sandbox
    --setenv GIT_COMMITTER_NAME agent --setenv GIT_COMMITTER_EMAIL agent@sandbox
    --setenv NPM_CONFIG_PREFIX /home/agent/.local
    --setenv AGENT_WORKER "${SB_WORKER:-main}"
    --setenv AGENT_BACKEND "$BACKEND"
    # Project scripts that talk to "Ollama" go through the proxy too (with BACKEND=llama it answers
    # Ollama's model-list endpoints itself), never straight to :11434, which would load a second copy.
    --setenv OLLAMA_BASE_URL "http://127.0.0.1:$api_port/v1"
    --setenv OLLAMA_HOST "http://127.0.0.1:$api_port"
    ${SB_BINDS[@]+"${SB_BINDS[@]}"}
    ${SB_ENV[@]+"${SB_ENV[@]}"}
  )
  [[ $tty == 0 ]] && args+=(--new-session)
  # The token goes in through a 0600 file, not --setenv: bwrap's argv is visible to every user in `ps`.
  if [[ -n "${GH_TOKEN:-}" ]]; then
    mkdir -p "$RUN"
    (umask 077; printf '%s' "$GH_TOKEN" > "$RUN/gh_token")
    args+=(--ro-bind "$RUN/gh_token" /run/secrets/gh_token)
    set -- bash -c 'export GH_TOKEN="$(</run/secrets/gh_token)"; exec "$@"' _ "$@"
  fi

  if [[ "$NET" == "on" ]]; then
    args+=(--share-net)
    bwrap "${args[@]}" "$@" || status=$?
  else
    # No network namespace access: tunnel only Ollama through a unix socket.
    mkdir -p "$RUN"
    local sock="$RUN/ollama.$$.sock"
    python3 "$ROOT/bridge.py" out "$sock" "127.0.0.1:$ka_port" &
    local bridge_pid=$!
    for _ in {1..50}; do [[ -S "$sock" ]] && break; sleep 0.1; done
    args+=(--bind "$sock" /run/ollama.sock)
    bwrap "${args[@]}" bash -c \
      "python3 /opt/agent/bridge.py in /run/ollama.sock $API_PORT & sleep 0.3; exec \"\$@\"" _ "$@" \
      || status=$?
    kill "$bridge_pid" 2>/dev/null || true
    rm -f "$sock"
  fi
  kill "$ka_pid" 2>/dev/null || true
  return "$status"
}

claude_args=(--append-system-prompt-file /opt/agent/prompts/system.md --dangerously-skip-permissions)

cmd_setup() {
  curl -sf "$OLLAMA_URL/api/version" >/dev/null || die "Ollama not reachable at $OLLAMA_URL"
  ollama list | awk '{print $1}' | grep -qx "$BASE_MODEL" || ollama pull "$BASE_MODEL"
  printf 'FROM %s\nPARAMETER num_ctx %s\n' "$BASE_MODEL" "$NUM_CTX" > "$RUN/Modelfile"
  ollama create "$MODEL" -f "$RUN/Modelfile"
  echo "ready: $MODEL ($BASE_MODEL, ctx $NUM_CTX per request)"
  if [[ "$BACKEND" == llama ]]; then
    echo "BACKEND=llama: ./llamasrv serves $NUM_PARALLEL slots x $NUM_CTX from this model's GGUF (no root needed)"
    return 0
  fi
  # With Ollama, NUM_PARALLEL is a server setting (one KV cache of NUM_CTX per slot) that lives in systemd.
  # Ollama ignores it for models it cannot run in parallel (qwen35: use BACKEND=llama).
  local cur conf=/etc/systemd/system/ollama.service.d/parallel.conf
  cur="$(systemctl show ollama -p Environment --value 2>/dev/null | grep -oE 'OLLAMA_NUM_PARALLEL=[0-9]+' | cut -d= -f2 || true)"
  ((${cur:-1} >= NUM_PARALLEL)) && return 0
  echo "Ollama serves ${cur:-1} request(s) at a time; config.env has NUM_PARALLEL=$NUM_PARALLEL. This needs root:"
  local cmds="sudo mkdir -p ${conf%/*} && printf '[Service]\\nEnvironment=\"OLLAMA_NUM_PARALLEL=$NUM_PARALLEL\"\\n' | sudo tee $conf >/dev/null && sudo systemctl daemon-reload && sudo systemctl restart ollama"
  echo "  $cmds"
  if [[ -t 0 ]]; then
    read -r -p "Run it now? (restarts Ollama; running agents retry) [y/N] " a
    [[ "$a" == [yY]* ]] && eval "$cmds" && echo "Ollama restarted with OLLAMA_NUM_PARALLEL=$NUM_PARALLEL"
  fi
}

cmd_new() {
  local name="${1:-}"; [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "usage: ./agent new NAME"
  local dir="$PROJECTS/$name"
  [[ -e "$dir" ]] && die "project '$name' already exists"
  cp -r "$ROOT/template" "$dir"
  git -C "$dir" init -q
  git -C "$dir" add -A
  git -C "$dir" -c user.name=agent -c user.email=agent@sandbox commit -qm "init project"
  echo "created $dir"
  echo "  1. describe the project in $dir/CLAUDE.md"
  echo "  2. list tasks in $dir/TODO.md"
  echo "  3. ./agent loop $name   (or ./agent chat $name)"
}

cmd_chat() {
  local dir; dir="$(project_dir "${1:-}")"; check_ollama
  sandbox "$dir" --tty -- claude "${claude_args[@]}"
}

cmd_shell() {
  local dir; dir="$(project_dir "${1:-}")"
  sandbox "$dir" --tty -- bash
}

# headless DIR PROMPT LOGFILE RUN_ID — one claude -p run, pretty-printed and logged
headless() {
  local dir="$1" prompt="$2" log="$3" rid="${4:-}"
  sandbox "$dir" -- timeout --kill-after=60 "$ITER_TIMEOUT" claude -p "$prompt" "${claude_args[@]}" \
    --max-turns "$MAX_TURNS" --output-format stream-json --verbose \
    < /dev/null | tee -a "$log" | AGENT_RUN="$rid" python3 "$ROOT/pretty.py"
}

# Every run is framed by two {"type":"harness"} lines in its log (who ran what, where, and how it
# ended), which ctxreport.py reads.   run_begin|run_end LOG RUN_ID FIELDS_JSON
run_begin() {
  jq -c --arg run "$2" '{type: "harness", event: "start", run: $run, t: now} + .' <<<"$3" >> "$1"
}
run_end() {
  jq -c --arg run "$2" '{type: "harness", event: "end", run: $run, t: now} + .' <<<"$3" >> "$1"
  # End-of-run report, detached so it never delays the next task.
  setsid python3 "$ROOT/ctxreport.py" "$1" --run "$2" --trigger end </dev/null >>"$LOGS/ctxreport.log" 2>&1 &
}

cmd_run() {
  local dir; dir="$(project_dir "${1:-}")"; check_ollama
  [[ -n "${2:-}" ]] || die "usage: ./agent run NAME \"PROMPT\""
  mkdir -p "$LOGS"
  local log="$LOGS/$1-$(date +%Y%m%d-%H%M%S).jsonl" rid="$(date +%s)-run-$RANDOM"
  run_begin "$log" "$rid" "$(jq -n --arg p "$1" --arg t "$2" --arg d "$dir" --arg b "$(git -C "$dir" rev-parse HEAD)" \
    '{project: $p, worker: "main", task: $t, workdir: $d, base: $b}')"
  headless "$dir" "$2" "$log" "$rid" || true
  autocommit "$dir" "agent run" || true
  run_end "$log" "$rid" "$(jq -n --arg h "$(git -C "$dir" rev-parse HEAD)" '{head: $h, merged: "n/a"}')"
}

autocommit() {
  local dir="$1" msg="$2"
  [[ -n "$(git -C "$dir" status --porcelain)" ]] || return 1
  git -C "$dir" add -A
  git -C "$dir" -c user.name=agent -c user.email=agent@sandbox commit -qm "$msg"
}

# ── interrupted runs ──────────────────────────────────────────────────────────
# A run that ends without a result (./agent stop --now, ITER_TIMEOUT, a crash) is paused, not merged:
# its session is resumed once, without tools, to write a short handoff; its edits are committed on the
# agent's branch; run/NAME/workers/ID.resume makes the same agent continue the task next time.
HANDOFF_PROMPT="You are being stopped before this task is finished. Write a handoff for the agent that \
will continue it: exactly 2 lines, at most 60 words in total, no preamble or formatting. \
Line 1: what is done so far and how it works (files, approach). \
Line 2: what is still needed to finish (next concrete steps, known problems)."

# A run that ends normally with its task still unchecked is asked why (shown in reports, and given to the
# next attempt).
DEBRIEF_PROMPT="You ended this run without finishing your task (its line is still unchecked). Answer in \
exactly 2 short lines, at most 50 words in total, no preamble or formatting. \
Line 1: why it was not finished (the actual blocker). \
Line 2: what would most have helped (a tool, access, data, information, more context, or a smaller task)."

handoff() {   # DIR SID [PROMPT] → the note on stdout (empty if the session cannot be resumed)
  [[ -n "$2" && "$2" != null ]] || return 0
  sandbox "$1" -- timeout 20m claude -p "${3:-$HANDOFF_PROMPT}" --resume "$2" --tools "" --max-turns 1 \
      --output-format json "${claude_args[@]}" </dev/null 2>/dev/null |
    jq -r '.result // empty' 2>/dev/null |
    python3 -c 'import sys
lines = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()][:2]
words, out = 80, []
for l in lines:
    w = l.split()[:words]; words -= len(w)
    if w: out.append(" ".join(w))
print("\n".join(out))' || true
}

pause_task() {   # DIR STATE WID SID CLAIM_JSON → writes STATE/workers/WID.resume
  local dir="$1" st="$2" wid="$3" sid="$4" claim="$5" note
  echo -e "\033[33m⏸ $wid: run interrupted — asking it for a handoff\033[0m"
  note="$(handoff "$dir" "$sid")"
  [[ -n "$note" ]] && echo -e "\033[2m$note\033[0m" || echo "(no handoff: the session could not be resumed)"
  autocommit "$dir" "$wid: interrupted: $(jq -r '.task // "" | .[:60]' <<<"$claim")"$'\n\n'"$note" || true
  jq --arg h "$note" --arg sid "$sid" '. + {handoff: $h, sid: $sid, paused: now}' <<<"$claim" > "$st/workers/$wid.resume"
}

# ── parallel agents ───────────────────────────────────────────────────────────
# One agent ("main") works in the project directory itself, exactly like the classic loop.
# With AGENTS > 1, agents w1..wN each get a git worktree in work/NAME/wK on branch agent/wK;
# sched.py hands out TODO.md tasks (claims + (after: ...) dependencies), and each finished task
# is merged back into the project's branch under a lock. State lives in run/NAME/.

worker_alive() { local f="$RUN/$1/workers/$2.pid"; [[ -f "$f" ]] && kill -0 "$(<"$f")" 2>/dev/null; }

live_workers() {   # live_workers [NAME] → "name/id" lines
  local f n
  for f in "$RUN"/${1:-*}/workers/*.pid; do
    [[ -f "$f" ]] && kill -0 "$(<"$f")" 2>/dev/null || continue
    n="${f#"$RUN"/}"; echo "${n%%/*}/$(basename "$f" .pid)"
  done
}

# Git config every worktree of DIR shares: the merge driver for the files all agents edit.
setup_parallel_repo() {
  local dir="$1" attrs
  git -C "$dir" config merge.agentlines.name "agent line merge"
  git -C "$dir" config merge.agentlines.driver "python3 $ROOT/mergelines.py %O %A %B"
  attrs="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)/info/attributes"
  mkdir -p "$(dirname "$attrs")"
  local f; for f in TODO.md NOTES.md TASKLOG.md; do
    grep -qxF "$f merge=agentlines" "$attrs" 2>/dev/null || echo "$f merge=agentlines" >> "$attrs"
  done
}

ensure_worktree() {   # DIR WT BRANCH MAIN
  local dir="$1" wt="$2" br="$3" main="$4"
  [[ -e "$wt/.git" ]] && return 0
  git -C "$dir" worktree prune
  # A leftover branch with work that never reached MAIN is kept under another name, not reset.
  if git -C "$dir" rev-parse -q --verify "$br" >/dev/null && ! git -C "$dir" merge-base --is-ancestor "$br" "$main"; then
    git -C "$dir" branch -m "$br" "$br-parked-$(date +%Y%m%d-%H%M%S)"
  fi
  mkdir -p "$(dirname "$wt")"
  git -C "$dir" worktree add -q -B "$br" "$wt" "$main"
}

# Merge the worktree's branch into MAIN: first MAIN into the branch (inside the worktree, where a
# conflict can be left for the agent), then fast-forward MAIN. Serialised per project.
integrate() {   # DIR WT MAIN STATE → 0 merged, 1 conflict
  local dir="$1" wt="$2" main="$3" st="$4"
  (
    flock 9
    local g=(-c user.name=agent -c user.email=agent@sandbox)
    if ! git -C "$wt" "${g[@]}" merge -q --no-edit "$main" >/dev/null 2>&1; then
      git -C "$wt" merge --abort 2>/dev/null || true
      exit 1
    fi
    autocommit "$dir" "edits made in the main checkout" || true
    git -C "$dir" "${g[@]}" merge -q --no-edit "$(git -C "$wt" rev-parse HEAD)" >/dev/null 2>&1 \
      || { git -C "$dir" merge --abort 2>/dev/null; exit 1; }
  ) 9>"$st/merge.lock"
}

conflict_prompt() {   # MAIN TASK
  cat <<EOF
Your branch finished this task, but it cannot be merged into $1 automatically because other agents
changed the same files in parallel:
$2

Do only this:
1. Run \`git merge $1\` and look at \`git status\` / \`git diff\` for the conflicts.
2. Resolve each conflict so both sides' changes survive. Do not start any new work.
3. Run the tests. Fix what the merge broke.
4. Commit the merge.
EOF
}

cmd_worker() {
  local name="${1:-}" wid="${2:-}" iters="${3:-}" dir; dir="$(project_dir "$name")"; check_ollama
  : "${iters:=$MAX_ITERS}"
  local st="$RUN/$name"; mkdir -p "$st/workers" "$LOGS"
  if [[ -z "$wid" ]]; then local k=1; while worker_alive "$name" "w$k"; do k=$((k + 1)); done; wid="w$k"; fi
  worker_alive "$name" "$wid" && die "agent $wid is already running on $name"
  if [[ "$wid" == main ]]; then
    [[ -z "$(live_workers "$name")" ]] || die "parallel agents are running on $name (./agent status $name)"
  else
    worker_alive "$name" main && die "a single-agent loop is running on $name"
  fi
  [[ -n "$(live_workers "$name")" ]] || rm -f "$st/attempts.json" "$st/failed.json" "$st"/workers/*.json
  echo $$ > "$st/workers/$wid.pid"
  export AGENT_PID=$$ MAX_TASK_ATTEMPTS MAX_STEP_ATTEMPTS
  local n; n="$(live_workers | wc -l)"
  ((n > NUM_PARALLEL)) && echo "warning: $n agents running but the model server runs NUM_PARALLEL=$NUM_PARALLEL at a time; requests will queue" >&2

  local wt="$dir" main="" tag="$name" ref=() SB_BINDS=() SB_ENV=() SB_WORKER="$wid" SB_TAG
  local log="$LOGS/$name-$(date +%Y%m%d-%H%M%S).jsonl"
  if [[ "$wid" != main ]]; then
    main="$(git -C "$dir" symbolic-ref --short HEAD)"
    wt="$ROOT/work/$name/$wid" tag="$name/$wid" ref=(--ref "$main")
    log="$LOGS/$name-$wid-$(date +%Y%m%d-%H%M%S).jsonl"
    # Agents start together; git config and worktree creation take a lock, so do them one at a time.
    ( flock 9; setup_parallel_repo "$dir"; ensure_worktree "$dir" "$wt" "agent/$wid" "$main" ) 9>"$st/merge.lock"
    # git inside the sandbox needs the shared .git and the merge driver at their host paths.
    SB_BINDS+=(--bind "$dir/.git" "$dir/.git" --ro-bind "$ROOT/mergelines.py" "$ROOT/mergelines.py")
    # Gitignored runtime data every agent shares with the main checkout (venvs, clones, databases).
    local p; while read -r p; do
      [[ -z "$p" || "$p" == \#* ]] && continue
      [[ -e "$dir/$p" ]] || mkdir -p "$dir/$p"
      SB_BINDS+=(--bind "$dir/$p" "/work/$p")
    done < <(cat "$dir/.agent-shared" 2>/dev/null)
  else
    rm -f "$dir/DONE"
  fi
  SB_TAG="$tag"
  trap "python3 '$ROOT/sched.py' release '$st' '$wid'; rm -f '$st/workers/$wid.pid'" EXIT   # expanded now: locals are gone at exit
  if [[ ! -f "$st/workers/$wid.resume" ]]; then   # was this agent's last run killed before it ended?
    local prev lr pat="$LOGS/$name-$wid-2*.jsonl"; [[ "$wid" == main ]] && pat="$LOGS/$name-2*.jsonl"
    prev="$(ls -t $pat 2>/dev/null | head -1 || true)"
    if [[ -n "$prev" ]] && lr="$(python3 "$ROOT/sched.py" lastrun "$prev")"; then
      pause_task "$wt" "$st" "$wid" "$(jq -r .sid <<<"$lr")" "$lr"
      run_end "$prev" "$(jq -r .rid <<<"$lr")" "$(jq -n --arg n "$(jq -r '.handoff // ""' "$st/workers/$wid.resume")" \
        '{merged: "paused", task_state: "interrupted", session: "cut off", note: $n}')"
    fi
  fi
  trap 'echo; echo "stopped."; exit 130' INT TERM

  local i=0 stuck=0 conflict=0 waited="" job="" task="" prompt rc
  while ((iters == 0 || i < iters)); do
    [[ -f "$st/stop" ]] && { echo "■ stop requested"; break; }
    if [[ "$wid" == main ]]; then
      [[ -f "$dir/DONE" ]] && { echo "✔ all tasks done"; break; }
    elif ((conflict == 0)); then
      autocommit "$wt" "$wid: leftover changes" || true
      if [[ -f "$st/workers/$wid.resume" ]]; then
        :   # an interrupted task: its work stays on the branch until the task is finished
      elif git -C "$wt" merge-base --is-ancestor HEAD "$main"; then
        git -C "$wt" reset -q --hard "$main"
      else
        conflict=1   # unmerged work from an earlier run (e.g. a crash mid-merge)
      fi
    fi
    if ((conflict)); then
      prompt="$(conflict_prompt "$main" "${task:-(earlier task)}")"
    else
      rc=0; job="$(python3 "$ROOT/sched.py" next "$st" "$wid" "$wt" "${ref[@]}")" || rc=$?
      case $rc in
        0) ;;
        10) echo "✔ all tasks done"; break ;;
        11) [[ "$waited" == "$job" ]] || echo -e "\033[2m… $wid waiting: $(jq -r '[.claimed[] | "\(.[0]) is on \(.[1][:70])"] | join("; ")' <<<"$job")\033[0m"
            waited="$job"; sleep 30; continue ;;
        12) echo "✖ the remaining tasks depend on tasks that were given up:"; jq -r '.failed[]' <<<"$job"; break ;;
        *) echo "✖ scheduler error ($rc)"; break ;;
      esac
      waited=""
      task="$(jq -r .task <<<"$job")"; prompt="$(jq -r .prompt <<<"$job")"
      [[ "$(jq -r '.unknown | length' <<<"$job")" == 0 ]] || echo "warning: unknown (after: ...) ids: $(jq -r '.unknown | join(", ")' <<<"$job")" >&2
    fi
    i=$((i + 1))
    local j="${job:-}" of="$iters" fix=""; [[ -n "$j" ]] || j='{}'; ((iters == 0)) && of="∞"; ((conflict)) && fix=" · resolving merge conflict"
    [[ "$(jq -r '.resumed // false' <<<"$j")" == true ]] && fix=" · continuing an interrupted run"
    echo -e "\n\033[1m━━ $name/$wid · iteration $i/$of · $(jq -r '.open // "?"' <<<"$j") open · attempt $(jq -r '.attempts // 1' <<<"$j")$fix ━━\033[0m"
    [[ -n "$(jq -r '.parent // empty' <<<"$j")" ]] && echo -e "\033[2m$(jq -r '.src + " ← " + .parent[:100]' <<<"$j")\033[0m"
    local ttl; ttl="$(jq -r '.title // empty' <<<"$j")"
    if [[ -n "$ttl" && "$ttl" != "$task" ]]; then echo -e "\033[1m$ttl\033[0m \033[2m— ${task#*— }\033[0m"; else echo -e "\033[2m$task\033[0m"; fi

    local rid base n0; rid="$(date +%s)-$wid-$RANDOM"; base="$(git -C "$wt" rev-parse HEAD)"
    n0=0; [[ -f "$log" ]] && n0="$(wc -l < "$log")"
    run_begin "$log" "$rid" "$(jq -c --arg p "$name" --arg w "$wid" --arg d "$wt" --arg b "$base" \
      --arg br "$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)" --argjson c "$conflict" \
      --argjson n "$(live_workers "$name" | wc -l)" --argjson np "$NUM_PARALLEL" --argjson ctx "$NUM_CTX" \
      '{project: $p, worker: $w, workdir: $d, base: $b, branch: $br, agents: $n, num_parallel: $np, num_ctx: $ctx,
        task: .task, src: .src, parent: .parent, attempts: .attempts, merge_fix: ($c > 0), resumed: (.resumed // false)}' <<<"$j")"
    # hooks/task_done.py tells the agent to stop once this line is checked (merge-fix runs have no task).
    local src; src="$(jq -r '.src // "TODO.md"' <<<"$j")"
    SB_ENV=(); ((conflict)) || SB_ENV=(--setenv AGENT_TASK "$task" --setenv AGENT_TASK_SRC "$src")
    headless "$wt" "$prompt" "$log" "$rid" || echo "(run exited non-zero)"
    SB_ENV=()
    local head merged="n/a" checked=0 was_fix=$conflict sid session state=open note=""
    sid="$(tail -n "+$((n0 + 1))" "$log" | grep -m1 '"subtype":"init"' | jq -r .session_id || true)"
    session="$(tail -n "+$((n0 + 1))" "$log" | grep '"type":"result"' | tail -1 |   # key order varies
      jq -r 'if .is_error then (if .subtype == "success" then "error" else .subtype end) else .subtype end' 2>/dev/null || true)"
    grep -qiF -- "- [x] $task" "$wt/$src" 2>/dev/null && checked=1
    # What became of the task: done, split (its line replaced by smaller ones), or still open.
    if ((was_fix)); then state="merge-fix"
    elif ((checked)); then state="done"
    elif ! grep -qF -- "- [ ] $task" "$wt/$src" 2>/dev/null; then state="split"
    fi
    # Cut off before its task was checked: pause it (handoff, same agent continues). Cut off after (it ran
    # on past its task) counts as finished.
    if [[ "$state" == open && -z "$session" ]]; then
      pause_task "$wt" "$st" "$wid" "$sid" "$(cat "$st/workers/$wid.json" 2>/dev/null || echo '{}')"
      merged="paused"; state="interrupted"; note="$(jq -r '.handoff // ""' "$st/workers/$wid.resume" 2>/dev/null)"
    elif [[ "$state" == open ]]; then
      echo -e "\033[33m✖ task not finished — asking the agent why\033[0m"
      note="$(handoff "$wt" "$sid" "$DEBRIEF_PROMPT")"
      # A session that died on an error (e.g. a failed compaction) often cannot be resumed: keep the error.
      [[ -n "$note" ]] || note="$(tail -n "+$((n0 + 1))" "$log" | grep '"type":"result"' | tail -1 |
        jq -r 'select(.is_error) | "Session error: " + (.result // "unknown")' 2>/dev/null | cut -c1-300 || true)"
      [[ -n "$note" ]] && echo -e "\033[2m$note\033[0m"
      python3 "$ROOT/sched.py" note "$st" "$(jq -r '.akey // ""' <<<"$j")" "$note"
    fi
    autocommit "$wt" "$wid: ${task:0:70}" || true
    head="$(git -C "$wt" rev-parse HEAD)"
    if [[ "$merged" == paused ]]; then
      echo -e "\033[33m⏸ work kept on $(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || echo "$wt"); this agent continues the task next time\033[0m"
    elif [[ "$wid" != main ]]; then
      if [[ "$head" == "$base" ]] && ((conflict == 0)); then
        merged="nothing"
      elif integrate "$dir" "$wt" "$main" "$st"; then
        merged="yes"; conflict=0
        echo -e "\033[32m⇢ merged into $main\033[0m"
      elif ((conflict < 2)); then
        merged="conflict"; conflict=$((conflict + 1))
        echo -e "\033[33m⚠ merge conflict with $main — next run resolves it\033[0m"
      else
        merged="parked"; conflict=0
        git -C "$wt" branch -f "agent/$wid-parked-$(date +%Y%m%d-%H%M%S)" HEAD
        git -C "$wt" reset -q --hard "$main"
        echo -e "\033[31m✖ could not merge; work kept on a parked branch, task goes back to the queue\033[0m"
      fi
    fi
    ((conflict)) || python3 "$ROOT/sched.py" release "$st" "$wid"
    run_end "$log" "$rid" "$(jq -n --arg h "$head" --arg m "$merged" --arg ts "$state" --arg s "${session:-cut off}" \
      --arg n "$note" '{head: $h, merged: $m, task_state: $ts, session: $s, note: $n}')"
    if [[ "$head" == "$base" ]]; then
      stuck=$((stuck + 1))
      echo "no changes this iteration ($stuck/${STUCK_LIMIT/#0/∞})"
      ((STUCK_LIMIT > 0 && stuck >= STUCK_LIMIT)) && { echo "✖ agent seems stuck — stopping"; break; }
    else
      stuck=0
    fi
  done
  echo "log: $log"
  git -C "$dir" log --oneline -5
}

cmd_loop() {
  local name="" iters="" jobs="$AGENTS"
  while (($#)); do
    case "$1" in
      -j) jobs="$2"; shift 2 ;;
      -j*) jobs="${1#-j}"; shift ;;
      *) if [[ -z "$name" ]]; then name="$1"; else iters="$1"; fi; shift ;;
    esac
  done
  local dir; dir="$(project_dir "$name")"; check_ollama
  rm -f "$RUN/$name/stop"
  ((jobs <= 1)) && { cmd_worker "$name" main "$iters"; return; }
  worker_alive "$name" main && die "a single-agent loop is running on $name"
  local ids=() k=1
  while ((${#ids[@]} < jobs)); do worker_alive "$name" "w$k" || ids+=("w$k"); k=$((k + 1)); done
  # tmux starts panes with the tmux server's environment, so hand over this shell's overrides.
  local envs=() v
  for v in BACKEND AGENT_CLAUDE_BIN MAX_TURNS STUCK_LIMIT MAX_TASK_ATTEMPTS MAX_STEP_ATTEMPTS ITER_TIMEOUT NET; do
    envs+=("$v=${!v:-}")
  done
  pane() { printf 'bash -c %q' "$(printf '%q ' env "${envs[@]}" "$ROOT/agent" worker "$name" "$1" "$iters"); echo; read -r -p '[agent exited — Enter closes this pane] '"; }
  local layout=even-vertical; ((jobs > 3)) && layout=tiled
  if [[ -n "${TMUX:-}" ]]; then
    local id; for id in "${ids[@]:1}"; do tmux split-window -d -t "$TMUX_PANE" "$(pane "$id")"; done
    tmux select-layout -t "$TMUX_PANE" "$layout" >/dev/null
    cmd_worker "$name" "${ids[0]}" "$iters"
  else
    local s="agent-$name"
    if tmux has-session -t "=$s" 2>/dev/null; then   # left over from an earlier loop
      if [[ -z "$(live_workers "$name")" ]]; then tmux kill-session -t "=$s"; else s="$s-$(date +%H%M%S)"; fi
    fi
    tmux new-session -d -s "$s" -x 240 -y 70 "$(pane "${ids[0]}")"
    local id; for id in "${ids[@]:1}"; do tmux split-window -d -t "$s" "$(pane "$id")"; done
    tmux select-layout -t "$s" "$layout" >/dev/null
    if [[ -t 1 ]]; then exec tmux attach -t "$s"; else echo "agents running in tmux session $s"; fi
  fi
}

cmd_status() {
  local name dir main
  for name in ${1:-$(ls "$RUN" 2>/dev/null)}; do
    dir="$PROJECTS/$name"; [[ -d "$dir/.git" && -d "$RUN/$name/workers" ]] || continue
    echo -e "\033[1m$name\033[0m"
    if worker_alive "$name" main || [[ -z "$(live_workers "$name")" ]]; then
      python3 "$ROOT/sched.py" status "$RUN/$name" "$dir"
    else
      main="$(git -C "$dir" symbolic-ref --short HEAD)"
      python3 "$ROOT/sched.py" status "$RUN/$name" "$dir" --ref "$main"
    fi
    echo
  done
}

descendants() { local c; for c in $(pgrep -P "$1"); do echo "$c"; descendants "$c"; done; }

cmd_stop() {
  local name="${1:-}"; project_dir "$name" >/dev/null
  mkdir -p "$RUN/$name"; touch "$RUN/$name/stop"
  local w pid
  if [[ "${2:-}" == --now ]]; then
    # Stop the claude runs only; each worker then writes a handoff, keeps the work on its branch and exits.
    for w in $(live_workers "$name"); do
      pid="$(<"$RUN/${w%%/*}/workers/${w#*/}.pid")"
      local d; for d in $(descendants "$pid"); do
        [[ "$(ps -o comm= -p "$d" 2>/dev/null)" == timeout ]] && kill -TERM "$d" 2>/dev/null
      done
    done
    echo "interrupting $name's agents: each writes a 2-line handoff (a minute or two), then exits"
  elif [[ "${2:-}" == --kill ]]; then
    for w in $(live_workers "$name"); do
      pid="$(<"$RUN/${w%%/*}/workers/${w#*/}.pid")"
      kill -TERM -- "-$(ps -o pgid= -p "$pid" | tr -d ' ')" 2>/dev/null || kill -TERM "$pid"
    done
    echo "killed $name's agents (each writes its handoff when it starts again)"
  else
    echo "$name's agents stop after their current task (./agent status $name)"
  fi
}

cmd_list() { ls -1 "$PROJECTS" 2>/dev/null; }

mkdir -p "$SANDBOX_HOME" "$PROJECTS" "$LOGS" "$RUN"
sub="${1:-}"; shift || true
case "$sub" in
  setup) cmd_setup "$@" ;;
  new)   cmd_new "$@" ;;
  chat)  cmd_chat "$@" ;;
  loop)  cmd_loop "$@" ;;
  worker) cmd_worker "$@" ;;
  status) cmd_status "$@" ;;
  stop)  cmd_stop "$@" ;;
  run)   cmd_run "$@" ;;
  shell) cmd_shell "$@" ;;
  list)  cmd_list ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

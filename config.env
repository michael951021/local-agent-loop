# Agent loop settings. Sourced by ./agent — edit freely.

# Ollama model the agent uses (created by `./agent setup` from BASE_MODEL).
BASE_MODEL=qwen3.8:27b-q8_0
MODEL=qwen-agent
# Context window per agent, in tokens. Claude Code alone uses ~16K and compacts at roughly NUM_CTX - CTX_MARGIN
# - 33K (96K per agent meant compacting at ~57K, every few minutes). With llama-server's 8-bit KV cache
# (LLAMA_ARGS) two slots of 128K take ~8 GB next to the 27B weights on 2x3090.
NUM_CTX=131072

OLLAMA_URL=http://127.0.0.1:11434
# Model server: "llama" = ./llamasrv (llama-server from Ollama's install, NUM_PARALLEL real slots, prompt
# cache that works for this hybrid model); "ollama" = Ollama (runs qwen35 one request at a time).
BACKEND=${BACKEND:-llama}
LLAMA_URL=http://127.0.0.1:11500
# Extra llama-server flags. Measured 2026-09-27 on 2x3090, thinking on (tests/llama_bench.py), tok/s for
# 1 stream / 2 at once: layer split 28/49, MTP 43/61, tensor split 41/67, tensor + MTP 80/84.
# -sm tensor: both GPUs work on every token (experimental in llama.cpp); draft-mtp: the model's own
# multi-token-prediction head drafts ~3 tokens per step (~70% accepted).
# -ctk/-ctv q8_0: 8-bit KV cache, half the memory of f16 (quality loss is negligible), so 2 x 128K fit.
LLAMA_ARGS=${LLAMA_ARGS--sm tensor --spec-type draft-mtp -ctk q8_0 -ctv q8_0}

# Parallel agents. `./agent loop NAME` starts AGENTS agents on NAME (override with -j N):
#   1  = one agent working in projects/NAME itself (the classic loop)
#   2+ = one git worktree per agent (work/NAME/wK), tasks claimed from TODO.md, merged back per task
# The server runs NUM_PARALLEL requests at once (llama: slots; ollama: systemd, see ./agent setup). Each slot gets its own
# KV cache of NUM_CTX tokens (2 x 128K fits with the 8-bit cache; with Ollama, 2 x 96K).
AGENTS=${AGENTS:-2}
NUM_PARALLEL=2
# Tokens kept free below NUM_CTX: Ollama's real prompt runs ~5-6K above what Claude Code counts.
CTX_MARGIN=8192

# on  = sandbox can reach the internet (pip/npm install work)
# off = sandbox can only reach Ollama
NET=on

# Loop limits
MAX_ITERS=${MAX_ITERS:-0}                  # max claude runs per `./agent loop` (0 = unlimited)
MAX_TURNS=${MAX_TURNS:-1000}               # max tool-use turns inside a single run
STUCK_LIMIT=${STUCK_LIMIT:-0}              # stop after N no-change iterations in a row (0 = off)
MAX_TASK_ATTEMPTS=${MAX_TASK_ATTEMPTS:-100} # max iterations spent on the same TODO item (0 = unlimited)
MAX_STEP_ATTEMPTS=${MAX_STEP_ATTEMPTS:-6}  # checklist step retries before the agent is told to take the checklist's failure path (0 = off)
ITER_TIMEOUT=${ITER_TIMEOUT:-3h}           # wall-clock cap for one claude run (coreutils `timeout` syntax; 0 = none)

# ./reportsrv: the reports as a website on the LAN
REPORTS_PORT=${REPORTS_PORT:-8765}
